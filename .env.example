# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file (it is already gitignored).

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg2://tesseractis:tesseractis@localhost:5432/tesseractis

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Sessions ---
# Generate a long random value in production, e.g.: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
SESSION_COOKIE_SECURE=false   # MUST be "true" in production (HTTPS only)

# --- Upload limits ---
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_DIMENSION_PX=6000

# --- AI provider ---
# "mock" requires no credentials and is safe for demos/assignments.
# "real" is not yet implemented (see app/ai/factory.py) — do not set this
# until a RealVisionProvider has been implemented and a provider chosen.
AI_PROVIDER=mock
AI_API_KEY=

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
# Example for production: https://tesseractis.vercel.app
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3000

# --- Frontend (set at build time, becomes visible in the browser bundle —
#     never put secrets in a NEXT_PUBLIC_ variable) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
